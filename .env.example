# Entorno de desarrollo - CRM Odontológico
# Copia este archivo a .env y ajusta los valores.

SPRING_PROFILES_ACTIVE=dev

# --- Base de datos ---
DATABASE_NAME=dentalcrm
DATABASE_USERNAME=dentalcrm
DATABASE_PASSWORD=

# --- Seguridad ---
# Mínimo 32 caracteres aleatorios. Genera con: openssl rand -base64 48
JWT_SECRET=
# Utilizado para cifrar tokens de redes sociales si no se define uno específico.
APP_SOCIAL_TOKEN_ENCRYPTION_KEY=${JWT_SECRET}
# Clave estable para cifrar credenciales administradas desde el panel.
# Si queda vacía, usa APP_SOCIAL_TOKEN_ENCRYPTION_KEY y luego JWT_SECRET.
APP_INTEGRACIONES_ENCRYPTION_KEY=
# Clave estable para cifrar firmas P12. Si queda vacía, usa JWT_SECRET.
APP_FIRMA_DIGITAL_ENCRYPTION_KEY=
JWT_EXPIRATION_MS=86400000

# --- Zona horaria ---
TIMEZONE=America/Guayaquil

# --- Despliegue con Nginx nativo ---
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=18082
FRONTEND_ROOT=/var/www/dentalcrm
FRONTEND_PUBLIC_URL=https://alan-tek.com/dental_crm

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://alan-tek.com,https://www.alan-tek.com,http://localhost:4200,http://localhost,http://127.0.0.1,http://192.168.1.43

# --- OpenWA ---
# auto detecta un OpenWA existente en el host; usa bundled para levantar el contenedor incluido.
OPENWA_MODE=auto
OPENWA_URL=http://openwa:2785
# API key (admin) del gateway OpenWA. Genera con: openssl rand -hex 24
OPENWA_API_KEY=
# Webhook que OpenWA avisa al backend (URL interna del compose)
OPENWA_WEBHOOK_URL=http://backend:8080/api/v1/webhooks/whatsapp
# Secreto HMAC para los webhooks (mínimo 16 caracteres). Genera con: openssl rand -hex 16
OPENWA_WEBHOOK_SECRET=

# --- Datos de la clínica (variables de plantillas) ---
CLINICA_NOMBRE=Clínica Dental Sonrisa Perfecta
CLINICA_DIRECCION=Av. Principal 123
CLINICA_TELEFONO=+593 99 123 4567

# --- Google Calendar ---
# Crear credenciales en: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Tipo: Aplicación web. URI de redirección autorizado: http://localhost:8080/api/v1/google/callback
# También se pueden configurar desde el panel admin en /google → "Credenciales OAuth"
# (En producción cambiar GOOGLE_REDIRECT_URI al dominio público del backend)
# OBLIGATORIO SOLO si no se usa el panel admin para configurarlas
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/google/callback
# URLs internas (por defecto apuntan a Google; se pueden sobreescribir para entorno de pruebas)
GOOGLE_AUTH_BASE_URL=https://accounts.google.com
GOOGLE_OAUTH_BASE_URL=https://oauth2.googleapis.com
GOOGLE_API_BASE_URL=https://www.googleapis.com

# --- Redes sociales (OAuth) ---
# También pueden configurarse en Configuración de integraciones.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8080/api/v1/social/callback/meta
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/api/v1/social/callback/tiktok

# --- Correo SMTP (opcional) ---
# Si MAIL_HOST está vacío no se envía correo: los avisos salen sólo por WhatsApp.
# Ej: smtp.gmail.com:587 con usuario/password de aplicación (no la contraseña normal)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=